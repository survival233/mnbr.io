# Copy to apps/api/.env after: bash scripts/deploy-sepolia.sh
# (Sepolia deployer/operator/attestor must hold ETH; funder must hold Circle test USDC.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/manebra
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/manebra
CHAIN_ENV=testnet
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
HANDOVER_ESCROW_ADDRESS=0xYOUR_DEPLOYED_ESCROW
# Keys: packages/settlement/contracts/.env.deploy (testnet only)
ATTESTOR_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
# Wallet holding Circle faucet USDC used to top up shopper agent wallets
USDC_FUNDER_PRIVATE_KEY=
MINTER_PRIVATE_KEY=
SMOKE_USDC_MODE=transfer
LOCAL_WALLET_SEED=manebra-local-dev-seed
HANDOVER_CODE_SECRET=change-me
WALLET_PROVIDER=local
SPEND_MAX_PER_TX_CENTS=500000
SPEND_DAILY_CAP_CENTS=1000000
