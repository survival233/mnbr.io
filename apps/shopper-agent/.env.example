# Always-on Manebra Shopper agent (Relay chat; optional leftover Linq harness)

PORT=8790
LINQ_FROM_PHONE=+12053968556
# From: linq tokens show
LINQ_API_KEY=
# From permanent webhook create (optional for local listen --forward-to)
# LINQ_WEBHOOK_SECRET=whsec_...

# Relay messenger — Shopper agent token (npm run demo long-polls GET /v1/events)
# RELAY_AGENT_TOKEN=rly_live_...
# RELAY_WEBHOOK_SECRET=whsec_...   # Render / public HTTPS only; conflicts with local long-poll
# RELAY_API_URL=https://api.relayapp.im

# Shared with catalog / LLM (or copy from apps/agent-cli/.env)
SERPAPI_API_KEY=
# Vision + conversational cognition require OpenAI (HF is text-only extract fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# Prefer openai so HF is never used for vision/cognition
LLM_PROVIDER=openai
# HF_TOKEN=
# Skip slow LLM extract (recommended for snappy chat)
# LINQ_LLM_EXTRACT=0
# Force cognition even on late payment steps
# LINQ_COGNITION=1
# Log private monologue JSON to server logs
# DEBUG_MONOLOGUE=1

# Session durability (default: apps/shopper-agent/.sessions.json)
# SHOPPER_SESSIONS_PATH=
# LINQ_SESSIONS_PATH=

# Settlement (Base Sepolia / local Anvil sandbox) — off by default
# SETTLEMENT_ENABLED=1
# Required in production when settlement is on (no localhost defaults):
# DATABASE_URL=
# DIRECT_URL=
# LOCAL_WALLET_SEED=
# HANDOVER_CODE_SECRET=
# INNGEST_BASE_URL=
# Loads remaining chain keys from apps/api/.env when present locally

# AgentCard sandbox — funding/cards only. Unset = Anvil if DEMO_LOCAL_CHAIN=1
# AGENTCARD_CLIENT_ID=
# AGENTCARD_CLIENT_SECRET=
# AGENTCARD_WEBHOOK_SECRET=

# "Connect with AgentCard" (OAuth 2.1 + PKCE + MCP; per-user virtual cards).
# The registered redirect_uri is <AGENTCARD_PUBLIC_URL>/api/agentcard/callback
# — served by this agent, so AGENTCARD_PUBLIC_URL must reach this process.
# Confidential client secret is server-side only; never logged.
# AGENTCARD_API_URL=https://mcp.agentcard.sh
# AGENTCARD_PUBLIC_URL=http://localhost:8790
# AGENTCARD_OAUTH_CLIENT_ID=
# AGENTCARD_OAUTH_CLIENT_SECRET=
# AGENTCARD_OAUTH_STORE_PATH=
