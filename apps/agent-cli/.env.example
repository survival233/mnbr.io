# Copy to apps/agent-cli/.env

# LLM (optional)
# OPENAI_API_KEY=
# HF_TOKEN=
# LLM_PROVIDER=hf

# Live store search
# SERPAPI_API_KEY=

# ── iMessage demo via Linq CLI ─────────────────────────────────────────────
# 1. Install: npm install -g @linqapp/cli@latest   (needs Node 22+, CLI ≥2.5.0)
# 2. Signup:  linq signup --email you@example.com
#             linq signup --email you@example.com --code XXXXXX --name "Your Name"
#    or:      linq login --token linq_xxx
# 3. Add your phone: linq contacts add +1XXXXXXXXXX
# 4. Text your Linq Number first from that phone (Shared Line inbound-first).
# 5. Set below and run:  npm run demo:linq
# (npm run demo ignores these — Relay only)
#
# DEMO_TRANSPORT=linq
# LINQ_TO_PHONE=+1XXXXXXXXXX
# LINQ_FROM_PHONE=+1YYYYYYYYYY
# LINQ_WEBHOOK_PORT=8787
# LINQ_CHAT_ID=
