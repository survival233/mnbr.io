# Traveler agent — Linq first; Relay optional later for chat pipe.

PORT=8791
TRAVELER_AGENT_PORT=8791

# Linq (primary chat)
LINQ_FROM_PHONE=
LINQ_API_KEY=
# From: linq webhooks create (shown once)
# LINQ_WEBHOOK_SECRET=whsec_...

# Relay messenger — Traveler agent token (npm run demo long-polls GET /v1/events)
# RELAY_TRAVELER_AGENT_TOKEN=rly_live_...  # preferred on Render if both keys exist
# RELAY_AGENT_TOKEN=rly_live_...
# RELAY_WEBHOOK_SECRET=whsec_...   # Render / public HTTPS only; conflicts with local long-poll
# RELAY_API_URL=https://api.relayapp.im

SERPAPI_API_KEY=
FLIGHTS_ALLOW_DEMO=1
# FLIGHT_PAYMENT_METHOD_ID=
# DATABASE_URL=

# AgentCard sandbox — traveler test card (4242…). Unset = skip wallet link
# AGENTCARD_CLIENT_ID=
# AGENTCARD_CLIENT_SECRET=
# AGENTCARD_WEBHOOK_SECRET=
