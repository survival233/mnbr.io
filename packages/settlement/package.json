{
  "name": "@manebra/settlement",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/core/index.ts",
    "./core": "./src/core/index.ts",
    "./server": "./src/server/index.ts",
    "./abi": "./src/core/abi.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:deploy": "forge script contracts/script/Deploy.s.sol --root contracts --broadcast --verify"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.54.0",
    "inngest": "^4.14.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@manebra/db": "*",
    "@manebra/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts"
}
