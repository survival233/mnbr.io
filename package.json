{
  "name": "manebra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run shopper-agent",
    "demo": "DEMO_MODE=relay tsx apps/agent-cli/src/main.mts",
    "demo:cli": "DEMO_MODE=cli tsx apps/agent-cli/src/main.mts",
    "demo:linq": "DEMO_MODE=linq DEMO_TRANSPORT=linq tsx apps/agent-cli/src/main.mts",
    "shopper-agent": "tsx apps/shopper-agent/src/main.mts",
    "traveler-agent": "tsx apps/traveler-agent/src/main.mts",
    "seed:linq-travelers": "tsx scripts/seed-linq-travelers.mts",
    "agent": "DEMO_MODE=relay tsx apps/agent-cli/src/main.mts",
    "mcp": "tsx apps/mcp/src/server.mts",
    "smoke": "tsx scripts/smoke-test.mts",
    "smoke:mcp": "tsx scripts/mcp-smoke.mts",
    "smoke:cal": "tsx scripts/calendar-smoke.mts",
    "smoke:shop": "tsx scripts/shopping-smoke.mts",
    "db:generate": "npm run generate --workspace @manebra/db",
    "db:migrate": "npm run migrate:dev --workspace @manebra/db",
    "test": "npm run test --workspace @manebra/shared --workspace @manebra/settlement --workspace @manebra/agents --workspace @manebra/calendar --workspace @manebra/catalog --workspace @manebra/flights",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contracts:test": "cd packages/settlement/contracts && forge test",
    "deploy:audit": "bash deploy-audit.sh"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  }
}
