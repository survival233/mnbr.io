# Manebra monorepo — required env keys (empty values only).
# Copy into the app you run; never commit filled .env files.
#
# Always-on iMessage agent:  see apps/linq-agent/.env.example
# Interactive CLI demo:      see apps/agent-cli/.env.example
# Settlement / API (Sepolia): see apps/api/.env.sepolia.example

NODE_ENV=

# Shared
DATABASE_URL=
DIRECT_URL=
SERPAPI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
LLM_PROVIDER=

# Linq (hosted agent)
PORT=
LINQ_FROM_PHONE=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_LLM_EXTRACT=
LINQ_SESSIONS_PATH=
SETTLEMENT_ENABLED=

# Settlement / chain (when SETTLEMENT_ENABLED=1)
RPC_URL=
USDC_ADDRESS=
HANDOVER_ESCROW_ADDRESS=
ATTESTOR_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
USDC_FUNDER_PRIVATE_KEY=
MINTER_PRIVATE_KEY=
LOCAL_WALLET_SEED=
HANDOVER_CODE_SECRET=
CHAIN_ENV=
INNGEST_EVENT_KEY=
INNGEST_BASE_URL=
INNGEST_DEV=
