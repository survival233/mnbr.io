# Manebra monorepo — required env keys (empty values only).
# Copy into the app you run; never commit filled .env files.
#
# Always-on Shopper agent:  see apps/shopper-agent/.env.example
# Interactive CLI demo:      see apps/agent-cli/.env.example
# Settlement / API (Sepolia): see apps/api/.env.sepolia.example

NODE_ENV=

# Shared
DATABASE_URL=
DIRECT_URL=
SERPAPI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
LLM_PROVIDER=

# Linq (hosted agent)
PORT=
LINQ_FROM_PHONE=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_LLM_EXTRACT=
LINQ_SESSIONS_PATH=
SETTLEMENT_ENABLED=

# Settlement / chain (when SETTLEMENT_ENABLED=1)
RPC_URL=
USDC_ADDRESS=
HANDOVER_ESCROW_ADDRESS=
ATTESTOR_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
USDC_FUNDER_PRIVATE_KEY=
MINTER_PRIVATE_KEY=
LOCAL_WALLET_SEED=
HANDOVER_CODE_SECRET=
CHAIN_ENV=
INNGEST_EVENT_KEY=
INNGEST_BASE_URL=
INNGEST_DEV=

# AgentCard sandbox (wallets / cards only — unset = Anvil escrow path)
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=
AGENTCARD_WEBHOOK_SECRET=

# AgentCard OAuth 2.1 + PKCE + MCP ("Connect with AgentCard" — per-user cards)
# Confidential client minted via the org endpoint; the secret is server-side
# only, rides on BOTH token exchange and refresh, and doubles as the org MCP
# bearer. Public (DCR) clients set only the CLIENT_ID. Never log the secret.
AGENTCARD_API_URL=
AGENTCARD_PUBLIC_URL=
AGENTCARD_OAUTH_CLIENT_ID=
AGENTCARD_OAUTH_CLIENT_SECRET=
# Per-user token store (default .agentcard-oauth-store.json)
AGENTCARD_OAUTH_STORE_PATH=

# AgentCard Commerce SDK (Vector C — traveler buy tool after escrow holds funds)
# Off by default. Same CLIENT_ID/SECRET as above (sandbox vs live chosen by
# WHICH credentials you load: npx agent-cards credentials --mode sandbox).
# COMMERCE_SDK_ENABLED=1 turns the surface on; COMMERCE_SDK_MODE=live is the
# extra opt-in required before any real order can be placed (default: sandbox).
COMMERCE_SDK_ENABLED=
COMMERCE_SDK_MODE=
# Optional base override (sandbox/staging); default https://api.agentcard.sh
AGENTCARD_COMMERCE_BASE_URL=
